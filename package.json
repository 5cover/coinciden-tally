{
  "name": "coinciden-tally",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/scripts/copy-data.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test dist/tests/*.test.js",
    "lint": "eslint src tests scripts eslint.config.ts",
    "explore": "pnpm build && node dist/scripts/explore.js",
    "import:presidents": "pnpm build && node dist/scripts/import-presidents.js"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./presidents": "./dist/src/domains/presidents/index.js"
  },
  "types": "./dist/src/index.d.ts",
  "files": ["dist/src", "dist/data", "README.md"],
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "cheerio": "^1.2.0",
    "eslint": "^10.11.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
