{
  "name": "coinciden-tally",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx scripts/copy-data.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm build && tsx --test tests",
    "lint": "eslint src tests scripts eslint.config.ts",
    "explore": "pnpm build && node scripts/explore.ts",
    "import:presidents": "pnpm build && node scripts/import-presidents.ts"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./presidents": "./dist/src/domains/presidents/index.js"
  },
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src",
    "dist/data",
    "README.md"
  ],
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "cheerio": "^1.2.0",
    "eslint": "^10.11.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "singleQuote": true,
    "arrowParens": "avoid",
    "bracketSameLine": true,
    "trailingComma": "es5",
    "semi": false
  }
}
